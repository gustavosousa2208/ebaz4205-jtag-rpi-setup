#!/bin/bash
set -euo pipefail

. "$EBAZ_BUNDLE_DIR/host-tools"
bundle_dir=$EBAZ_BUNDLE_DIR
ebaz_init_host

echo "$$" >"$EBAZ_PIDFILE"
upload_cfg=${EBAZ_UPLOAD_CFG:-$EBAZ_BUNDLE_DIR/upload-code.cfg}
if [ "${EBAZ_JTAG_ADAPTER:-}" = bananapi-m2-zero-mmio ]; then
    exec sudo -n "$EBAZ_OPENOCD" \
        -c "set ::env(EBAZ_BUNDLE_DIR) {$EBAZ_BUNDLE_DIR}" \
        -c "set ::env(EBAZ_ELF) {$EBAZ_ELF}" \
        -c "set ::env(EBAZ_BITSTREAM) {$EBAZ_BITSTREAM}" \
        -c "set ::env(EBAZ_PCAP_BIN) {$EBAZ_PCAP_BIN}" \
        -c "set ::env(EBAZ_ENTRY) {$EBAZ_ENTRY}" \
        -c "set ::env(EBAZ_PIDFILE) {$EBAZ_PIDFILE}" \
        -c "set ::env(EBAZ_UPLOAD_CFG) {$EBAZ_UPLOAD_CFG}" \
        -c "set ::env(EBAZ_LOAD_BITSTREAM) {$EBAZ_LOAD_BITSTREAM}" \
        -c "set ::env(EBAZ_SUCCESS_MARKER) {$EBAZ_SUCCESS_MARKER}" \
        -c "set ::env(EBAZ_PLD_DEVICE) {$EBAZ_PLD_DEVICE}" \
        -c "set ::env(EBAZ_PLD_RETRIES) {$EBAZ_PLD_RETRIES}" \
        -c "set ::env(EBAZ_JTAG_RATE_LADDER) {$EBAZ_JTAG_RATE_LADDER}" \
        -c "set ::env(EBAZ_TEST_FAIL_PL_ATTEMPT) {$EBAZ_TEST_FAIL_PL_ATTEMPT}" \
        -c "set ::env(EBAZ_JTAG_ADAPTER) {$EBAZ_JTAG_ADAPTER}" \
        -c "bindto 127.0.0.1" \
        -c "gdb port 3333" \
        -c "tcl port disabled" \
        -c "telnet port disabled" \
        -s "$EBAZ_OPENOCD_SCRIPTS" \
        -f "$EBAZ_ADAPTER_CFG" \
        -f "$EBAZ_BUNDLE_DIR/ebaz4205.cfg" \
        -f "$upload_cfg"
else
    exec "$EBAZ_OPENOCD" \
        -c "bindto 127.0.0.1" \
        -c "gdb port 3333" \
        -c "tcl port disabled" \
        -c "telnet port disabled" \
        -s "$EBAZ_OPENOCD_SCRIPTS" \
        -f "$EBAZ_ADAPTER_CFG" \
        -f "$EBAZ_BUNDLE_DIR/ebaz4205.cfg" \
        -f "$upload_cfg"
fi
