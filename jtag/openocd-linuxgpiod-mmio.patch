 	bitbang_interface = &linuxgpiod_bitbang;
 	adapter_gpio_config = adapter_gpio_get_config();
+	if (ebaz_mmio_prepare() != ERROR_OK)
+		return ERROR_JTAG_INIT_FAILED;
 
 	/*
 	 * Configure JTAG/SWD signals. Default directions and initial states are handled
@@ -752,6 +902,17 @@ static int linuxgpiod_init(void)
 			|| helper_get_line(ADAPTER_GPIO_IDX_LED) != ERROR_OK)
 		goto out_error;
 
+	if (ebaz_mmio_requested) {
+		uint32_t cfg = ebaz_pio[EBAZ_PC_CFG0_OFF / 4];
+		cfg &= ~0xffffu;
+		cfg |= 1u << 0;
+		cfg |= 1u << 8;
+		cfg |= 1u << 12;
+		ebaz_pio[EBAZ_PC_CFG0_OFF / 4] = cfg;
+		__sync_synchronize();
+		LOG_INFO("EBAZ Allwinner Port-C MMIO acceleration enabled");
+	}
+
 	return ERROR_OK;
 
