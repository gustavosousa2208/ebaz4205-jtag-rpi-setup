@@ -347,6 +408,16 @@ static enum bb_value linuxgpiod_read(void)
  */
 static int linuxgpiod_write(int tck, int tms, int tdi)
 {
+	if (ebaz_mmio_requested) {
+		uint32_t value = ebaz_pio[EBAZ_PC_DAT_OFF / 4] & ~EBAZ_PC_OUTPUT_MASK;
+		value |= (uint32_t)(tdi & 1) << 0;
+		value |= (uint32_t)(tck & 1) << 2;
+		value |= (uint32_t)(tms & 1) << 3;
+		ebaz_pio[EBAZ_PC_DAT_OFF / 4] = value;
+		__sync_synchronize();
+		return ERROR_OK;
+	}
+
 	static int last_tck;
 	static int last_tms;
 	static int last_tdi;
@@ -585,6 +656,7 @@ static int linuxgpiod_quit(void)
 	LOG_DEBUG("linuxgpiod_quit");
 	for (int i = 0; i < ADAPTER_GPIO_IDX_NUM; ++i)
 		helper_release(i);
+	ebaz_mmio_restore();
 
 	return ERROR_OK;
 }
@@ -701,6 +773,8 @@ static int linuxgpiod_init(void)
 
 	bitbang_interface = &linuxgpiod_bitbang;
 	adapter_gpio_config = adapter_gpio_get_config();
+	if (ebaz_mmio_prepare() != ERROR_OK)
+		return ERROR_JTAG_INIT_FAILED;
 
 	/*
 	 * Configure JTAG/SWD signals. Default directions and initial states are handled
@@ -752,6 +826,17 @@ static int linuxgpiod_init(void)
 			|| helper_get_line(ADAPTER_GPIO_IDX_LED) != ERROR_OK)
 		goto out_error;
 
+	if (ebaz_mmio_requested) {
