#!/bin/bash
set -euo pipefail

bundle_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$bundle_dir/.." && pwd)
bitstream=${1:-$project_dir/hardware/ebaz_test.bit}

. "$bundle_dir/select-adapter"
. "$bundle_dir/host-tools"
ebaz_init_host

pid_file="$bundle_dir/run/openocd.pid"
if [ -r "$pid_file" ]; then
    old_pid=$(cat "$pid_file")
    if [[ "$old_pid" =~ ^[0-9]+$ ]] && ebaz_process_alive "$old_pid"; then
        echo "Stopping previous OpenOCD process $old_pid..."
        ebaz_stop_process "$old_pid"
    fi
fi

if [ ! -r "$bitstream" ]; then
    echo "Bitstream not found or unreadable: $bitstream" >&2
    echo "Usage: $0 [design.bit]" >&2
    exit 2
fi

EBAZ_BITSTREAM=$(ebaz_abs_path "$bitstream")
EBAZ_BUNDLE_DIR=$bundle_dir

# pl-program.tcl reads every one of these unconditionally; they used to be set only by upload-code,
# which is why the PL-only path failed with "no such element in array".
pld_retries=${EBAZ_PLD_RETRIES:-3}
jtag_rate_ladder=${EBAZ_JTAG_RATE_LADDER:-1000,500,250,100}
if ! [[ "$pld_retries" =~ ^[1-9][0-9]*$ ]]; then
    echo "EBAZ_PLD_RETRIES must be a positive integer." >&2
    exit 2
fi
if ! [[ "$jtag_rate_ladder" =~ ^[1-9][0-9]*(,[1-9][0-9]*)*$ ]]; then
    echo "EBAZ_JTAG_RATE_LADDER must be comma-separated positive integers." >&2
    exit 2
fi
EBAZ_PLD_RETRIES=$pld_retries
EBAZ_JTAG_RATE_LADDER=$jtag_rate_ladder
EBAZ_TEST_FAIL_PL_ATTEMPT=${EBAZ_TEST_FAIL_PL_ATTEMPT:-}
EBAZ_SUCCESS_MARKER=${EBAZ_SUCCESS_MARKER:-$bundle_dir/run/pl-success.txt}
EBAZ_ENTRY=${EBAZ_ENTRY:-pl-only-load}

mkdir -p "$bundle_dir/run"
export EBAZ_BITSTREAM EBAZ_BUNDLE_DIR EBAZ_PLD_DEVICE
export EBAZ_ADAPTER_CFG EBAZ_CMSIS_DAP_SERIAL
export EBAZ_PLD_RETRIES EBAZ_JTAG_RATE_LADDER EBAZ_TEST_FAIL_PL_ATTEMPT EBAZ_SUCCESS_MARKER EBAZ_ENTRY

log_dir="$bundle_dir/logs"
mkdir -p "$log_dir"
timestamp=$(date '+%Y%m%d-%H%M%S')
log_file="$log_dir/${timestamp}-bitstream.log"

{
    echo "time=$(ebaz_iso_time)"
    echo "script=upload-bitstream"
    echo "host=$EBAZ_HOST_OS"
    echo "adapter=$EBAZ_JTAG_ADAPTER"
    echo "openocd=$EBAZ_OPENOCD"
    echo "pld_device=$EBAZ_PLD_DEVICE"
    echo "bitstream=$EBAZ_BITSTREAM"
    ebaz_sha256_report "$EBAZ_BITSTREAM"
    uname -a
} | tee "$log_file"

set +e
# The configuration travels on OpenOCD's command line rather than in the environment: the pinned
# sudoers rule grants NOPASSWD without SETENV, so exported values would not survive elevation.
mapfile -t env_args < <(ebaz_env_args EBAZ_BUNDLE_DIR EBAZ_BITSTREAM EBAZ_PLD_DEVICE EBAZ_PLD_RETRIES \
    EBAZ_JTAG_RATE_LADDER EBAZ_JTAG_ADAPTER EBAZ_TEST_FAIL_PL_ATTEMPT EBAZ_SUCCESS_MARKER EBAZ_ENTRY \
    EBAZ_ADAPTER_CFG EBAZ_CMSIS_DAP_SERIAL)
openocd_argv=("$EBAZ_OPENOCD" -s "$EBAZ_OPENOCD_SCRIPTS" "${env_args[@]}"
    -f "$EBAZ_ADAPTER_CFG" -f "$bundle_dir/ebaz4205.cfg" -f "$bundle_dir/upload-bitstream.cfg")
if [ "$EBAZ_USE_SUDO" = 1 ]; then
    sudo -n "${openocd_argv[@]}" 2>&1 | tee -a "$log_file"
else
    "${openocd_argv[@]}" 2>&1 | tee -a "$log_file"
fi
status=${PIPESTATUS[0]}
set -e

echo "exit_status=$status" | tee -a "$log_file"
echo "Log saved to: $log_file"
exit "$status"
