#!/bin/bash
set -euo pipefail

bundle_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$bundle_dir/.." && pwd)
. "$bundle_dir/select-adapter"
. "$bundle_dir/host-tools"
ebaz_init_host

force_full=false
capture_uart=false
keep_openocd=false
uart_seconds=${EBAZ_UART_SECONDS:-3}
pld_retries=${EBAZ_PLD_RETRIES:-3}
upload_timeout_seconds=${EBAZ_UPLOAD_TIMEOUT_SECONDS:-300}
if ! [[ "$pld_retries" =~ ^[0-9]+$ ]] || [ "$pld_retries" -lt 1 ]; then
    echo "EBAZ_PLD_RETRIES must be a positive integer." >&2
    exit 2
fi
if ! [[ "$upload_timeout_seconds" =~ ^[0-9]+$ ]] || [ "$upload_timeout_seconds" -lt 1 ]; then
    echo "EBAZ_UPLOAD_TIMEOUT_SECONDS must be a positive integer." >&2
    exit 2
fi
EBAZ_PLD_RETRIES=$pld_retries
while [ "$#" -gt 0 ]; do
    case "$1" in
        --full)
            force_full=true
            shift
            ;;
        --uart)
            capture_uart=true
            shift
            ;;
        --uart-seconds)
            capture_uart=true
            uart_seconds=${2:-}
            if ! [[ "$uart_seconds" =~ ^[0-9]+$ ]] || [ "$uart_seconds" -lt 1 ]; then
                echo "--uart-seconds requires a positive integer." >&2
                exit 2
            fi
            shift 2
            ;;
        --keep-openocd)
            keep_openocd=true
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Usage: $0 [--full] [--uart] [--uart-seconds N] [--keep-openocd] [application.elf] [design.bit]" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done
elf=${1:-$project_dir/build/hello.elf}
bitstream=${2:-$project_dir/hardware/ebaz_test.bit}

if [ ! -r "$elf" ]; then
    echo "ELF not found or unreadable: $elf" >&2
    echo "Usage: $0 [--full] [--uart] [--uart-seconds N] [--keep-openocd] [application.elf] [design.bit]" >&2
    exit 2
fi
if [ ! -r "$bitstream" ]; then
    echo "Bitstream not found or unreadable: $bitstream" >&2
    echo "Usage: $0 [--full] [--uart] [--uart-seconds N] [--keep-openocd] [application.elf] [design.bit]" >&2
    exit 2
fi
if ! command -v arm-none-eabi-readelf >/dev/null 2>&1; then
    echo "arm-none-eabi-readelf is required to determine the ELF entry point." >&2
    exit 2
fi

EBAZ_BUNDLE_DIR=$bundle_dir
EBAZ_ELF=$(ebaz_abs_path "$elf")
EBAZ_BITSTREAM=$(ebaz_abs_path "$bitstream")
EBAZ_ENTRY=$(arm-none-eabi-readelf -h "$EBAZ_ELF" | awk '/Entry point address:/ {print $4; exit}')
if [ -z "$EBAZ_ENTRY" ]; then
    echo "Could not determine the entry point from: $EBAZ_ELF" >&2
    exit 2
fi

run_dir="$bundle_dir/run"
log_dir="$bundle_dir/logs"
mkdir -p "$run_dir" "$log_dir"
pid_file="$run_dir/openocd.pid"
bitstream_hash_file="$run_dir/bitstream.sha256"
pl_verified_hash_file="$run_dir/pl-verified.sha256"
full_init_marker="$run_dir/full-init-required"
success_marker="$run_dir/upload-success"
requested_bitstream_hash=$(ebaz_sha256_value "$EBAZ_BITSTREAM")

if [ -e "$full_init_marker" ] && ! $force_full; then
    echo "The imported platform changed PS initialization." >&2
    echo "Power-cycle the EBAZ4205, then run: make upload-full" >&2
    exit 3
fi

old_pid=""
old_openocd_live=false
if [ -r "$pid_file" ]; then
    old_pid=$(tr -dc '0-9' <"$pid_file")
    if [ -n "$old_pid" ] && ebaz_process_alive "$old_pid"; then
        old_openocd_live=true
    fi
fi

programmed_bitstream_hash=""
if [ -r "$pl_verified_hash_file" ]; then
    programmed_bitstream_hash=$(tr -dc '0-9a-fA-F' <"$pl_verified_hash_file")
fi

if $force_full || [ -z "$programmed_bitstream_hash" ]; then
    upload_mode=full-initialization
    EBAZ_UPLOAD_CFG="$bundle_dir/upload-code.cfg"
    EBAZ_LOAD_BITSTREAM=1
elif [ "$programmed_bitstream_hash" = "$requested_bitstream_hash" ]; then
    upload_mode=code-only
    EBAZ_UPLOAD_CFG="$bundle_dir/upload-code-fast.cfg"
    EBAZ_LOAD_BITSTREAM=0
else
    upload_mode=bitstream-and-code
    EBAZ_UPLOAD_CFG="$bundle_dir/upload-code-fast.cfg"
    EBAZ_LOAD_BITSTREAM=1
fi

if $old_openocd_live; then
    echo "Refreshing the OpenOCD connection (stopping process $old_pid)..."
    ebaz_stop_process "$old_pid"
    for _ in $(seq 1 30); do
        ebaz_process_alive "$old_pid" || break
        sleep 0.1
    done
fi

EBAZ_PIDFILE=$pid_file
EBAZ_SUCCESS_MARKER=$success_marker
ebaz_remove_file "$success_marker"
if [ "$EBAZ_LOAD_BITSTREAM" = 1 ]; then
    ebaz_remove_file "$bitstream_hash_file"
    ebaz_remove_file "$pl_verified_hash_file"
fi

export EBAZ_BUNDLE_DIR EBAZ_ELF EBAZ_BITSTREAM EBAZ_ENTRY EBAZ_PIDFILE
export EBAZ_UPLOAD_CFG EBAZ_LOAD_BITSTREAM EBAZ_SUCCESS_MARKER EBAZ_PLD_DEVICE
export EBAZ_ADAPTER_CFG EBAZ_CMSIS_DAP_SERIAL EBAZ_OPENOCD
export EBAZ_OPENOCD_SCRIPTS EBAZ_USE_SUDO
export EBAZ_PLD_RETRIES

timestamp=$(date '+%Y%m%d-%H%M%S')
log_file="$log_dir/${timestamp}-code.log"
uart_log="$log_dir/${timestamp}-uart.log"

{
    echo "time=$(ebaz_iso_time)"
    echo "script=upload-code"
    echo "mode=$upload_mode"
    echo "host=$EBAZ_HOST_OS"
    echo "adapter=$EBAZ_JTAG_ADAPTER"
    echo "openocd=$EBAZ_OPENOCD"
    echo "pld_device=$EBAZ_PLD_DEVICE"
    echo "elf=$EBAZ_ELF"
    echo "bitstream=$EBAZ_BITSTREAM"
    echo "entry=$EBAZ_ENTRY"
    echo "previous_openocd_pid=${old_pid:-none}"
    echo "requested_bitstream_sha256=$requested_bitstream_hash"
    echo "programmed_bitstream_sha256=${programmed_bitstream_hash:-unknown}"
    echo "pld_retries=$pld_retries"
    echo "upload_timeout_seconds=$upload_timeout_seconds"
    ebaz_sha256_report "$EBAZ_ELF"
    ebaz_sha256_report "$EBAZ_BITSTREAM"
    uname -a
} | tee "$log_file"

uart_pid=""
openocd_job=""

cleanup() {
    if [ -n "$uart_pid" ] && kill -0 "$uart_pid" 2>/dev/null; then
        kill "$uart_pid" 2>/dev/null || true
        wait "$uart_pid" 2>/dev/null || true
    fi
    uart_pid=""

    if ! $keep_openocd && [ -r "$pid_file" ]; then
        cleanup_openocd_pid=$(tr -dc '0-9' <"$pid_file")
        if [ -n "$cleanup_openocd_pid" ] &&
           ebaz_process_alive "$cleanup_openocd_pid"; then
            ebaz_stop_process "$cleanup_openocd_pid" 2>/dev/null || true
        fi
        ebaz_remove_file "$pid_file"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if $capture_uart && [ -n "${EBAZ_UART_DEVICE:-}" ] && [ -e "$EBAZ_UART_DEVICE" ]; then
    python3 "$bundle_dir/uart-capture.py" "$EBAZ_UART_DEVICE" 3600 \
        >"$uart_log" 2>&1 &
    uart_pid=$!
    sleep 0.2
    echo "uart_capture=$EBAZ_UART_DEVICE,115200 -> $uart_log" | tee -a "$log_file"
elif $capture_uart; then
    echo "uart_capture=skipped (no serial device found)" | tee -a "$log_file"
else
    echo "uart_capture=disabled (use --uart to enable)" | tee -a "$log_file"
fi

if [ "$upload_mode" = full-initialization ]; then
    echo "Full path: PS initialization, bitstream, then ELF." | tee -a "$log_file"
elif [ "$upload_mode" = bitstream-and-code ]; then
    echo "Fast path: changed bitstream, then ELF; PS initialization is skipped." | tee -a "$log_file"
else
    echo "Fast path: ELF only; PS initialization and bitstream upload are skipped." | tee -a "$log_file"
fi

if [ "$EBAZ_USE_SUDO" = 1 ]; then
    sudo --preserve-env=EBAZ_BUNDLE_DIR,EBAZ_ELF,EBAZ_BITSTREAM,EBAZ_ENTRY,EBAZ_PIDFILE,EBAZ_UPLOAD_CFG,EBAZ_LOAD_BITSTREAM,EBAZ_SUCCESS_MARKER,EBAZ_PLD_DEVICE,EBAZ_ADAPTER_CFG,EBAZ_CMSIS_DAP_SERIAL,EBAZ_OPENOCD,EBAZ_OPENOCD_SCRIPTS,EBAZ_USE_SUDO,EBAZ_PLD_RETRIES \
        "$bundle_dir/openocd-daemon" >>"$log_file" 2>&1 &
else
    nohup "$bundle_dir/openocd-daemon" >>"$log_file" 2>&1 </dev/null &
fi
openocd_job=$!

status=1
for _ in $(seq 1 $((upload_timeout_seconds * 5))); do
    if [ -s "$success_marker" ]; then
        status=0
        break
    fi
    if ! kill -0 "$openocd_job" 2>/dev/null; then
        break
    fi
    sleep 0.2
done

if [ "$status" -eq 0 ]; then
    printf '%s\n' "$requested_bitstream_hash" >"$bitstream_hash_file"
    if [ "$EBAZ_LOAD_BITSTREAM" = 1 ]; then
        printf '%s\n' "$requested_bitstream_hash" >"$pl_verified_hash_file"
    fi
    if [ "$upload_mode" = full-initialization ]; then
        rm -f -- "$full_init_marker"
    fi
elif ebaz_process_alive "$openocd_job"; then
    echo "Upload failed or timed out; stopping OpenOCD." | tee -a "$log_file"
    ebaz_stop_process "$openocd_job"
fi
if [ "$status" -ne 0 ]; then
    ebaz_remove_file "$bitstream_hash_file"
    ebaz_remove_file "$pl_verified_hash_file"
fi

if [ -n "$uart_pid" ]; then
    sleep "$uart_seconds"
    kill "$uart_pid" 2>/dev/null || true
    wait "$uart_pid" 2>/dev/null || true
    uart_pid=""
    echo "--- UART capture ---" | tee -a "$log_file"
    tee -a "$log_file" <"$uart_log"
    echo "--- end UART capture ---" | tee -a "$log_file"
fi

echo "exit_status=$status" | tee -a "$log_file"
echo "Log saved to: $log_file"
if [ "$status" -eq 0 ]; then
    if [ "$upload_mode" = code-only ]; then
        echo "Fast upload complete: only the ELF was transferred."
    elif [ "$upload_mode" = bitstream-and-code ]; then
        echo "Bitstream changed: bitstream and ELF transferred without PS initialization."
    else
        echo "Initial upload complete: PS initialized, then bitstream and ELF transferred."
    fi
    if $keep_openocd; then
        echo "OpenOCD remains attached for the next fast upload."
        echo "PID file: $pid_file"
    else
        echo "Stopping OpenOCD so this command exits cleanly."
    fi
else
    tail -80 "$log_file"
    if [ "$upload_mode" != full-initialization ]; then
        echo "If the board was reset or power-cycled, power-cycle it cleanly and run: $0 --full" >&2
    fi
fi
exit "$status"
